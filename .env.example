# ---- Database (Neon free tier: https://neon.tech) ----
DATABASE_URL="postgresql://user:password@host.neon.tech/runna?sslmode=require"

# ---- Auth.js ----
# generate with: openssl rand -base64 32
AUTH_SECRET=""
# Local: http://localhost:3000. On Vercel: your deployment URL, https included.
AUTH_URL="http://localhost:3000"

# ---- Google sign-in (optional) ----
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <your origin>/api/auth/callback/google
# Leave both blank to hide the Google button entirely.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Token encryption (AES-256-GCM) ----
# generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# ---- Strava (register at https://www.strava.com/settings/api) ----
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/api/integrations/strava/callback"
# any random string; used for the webhook subscription handshake
STRAVA_VERIFY_TOKEN=""

# ---- Cron (protects /api/cron/*) ----
CRON_SECRET=""
